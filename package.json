{
  "name": "dsh-revise",
  "version": "0.1.0",
  "description": "Point at your frontend, request changes, and review the result with screenshots and code diffs in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lostforest7/dsh-revise.git"
  },
  "homepage": "https://github.com/Lostforest7/dsh-revise#readme",
  "bugs": {
    "url": "https://github.com/Lostforest7/dsh-revise/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./vite": { "types": "./lib/vite.d.ts", "import": "./lib/vite.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "visual-review",
    "vite",
    "react"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:workbench": "tsx scripts/dev-server.ts",
    "dev:example": "vite --config examples/vite-react/vite.config.ts --host 127.0.0.1",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-session-query": { "optional": true },
    "vite": { "optional": true }
  },
  "overrides": {
    "@deepseek-ai/libreoffice-kit": { "fflate": "0.8.3" }
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "diff": "9.0.0",
    "magic-string": "1.4.2",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@playwright/test": "1.63.0",
    "@types/diff": "7.0.2",
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
